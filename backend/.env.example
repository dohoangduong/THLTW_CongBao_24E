APP_NAME="Bao Cong Mobile"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Import docs/bao_cong.sql vao MySQL (XAMPP/Laragon) truoc, hoac tu tao database roi chay migrate
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bao_cong
DB_USERNAME=root
DB_PASSWORD=

# Dung file thay vi database de khong phu thuoc them bang sessions/cache/jobs
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
